<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info>
    <title>Lunar and Planetary Science Conference (abstracts)</title>
    <title-short>LPSC</title-short>
    <id>http://www.zotero.org/styles/lpsc</id>
    <link href="https://www.hou.usra.edu/meetings/lpsc/" rel="documentation"/>
    <author>
      <name>Michael Phillips</name>
    </author>
    <category citation-format="numeric"/>
    <category field="science"/>
    <summary>Compact numbered references used in LPSC and other LPI meeting abstracts: [1] Author A. B. et al. (2022) JGR Planets, 127, e2021JE007018.</summary>
    <updated>2026-10-30T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"
            initialize-with=". " name-as-sort-order="all" sort-separator=" "/>
      <et-al font-style="normal"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued" prefix="(" suffix=")">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="(n.d.)"/>
      </else>
    </choose>
  </macro>
  <macro name="container">
    <choose>
      <if variable="container-title-short">
        <text variable="container-title-short"/>
      </if>
      <else-if variable="container-title">
        <text variable="container-title"/>
      </else-if>
      <else-if variable="event-title">
        <text variable="event-title"/>
      </else-if>
      <else-if variable="event">
        <text variable="event"/>
      </else-if>
    </choose>
  </macro>
  <macro name="locator-details">
    <choose>
      <if type="paper-conference speech" match="any">
        <group delimiter=", ">
          <text macro="container"/>
          <choose>
            <if variable="number">
              <text variable="number" prefix="Abstract #"/>
            </if>
            <else-if variable="page">
              <text variable="page" prefix="Abstract #"/>
            </else-if>
          </choose>
        </group>
      </if>
      <else-if type="book thesis report" match="any">
        <group delimiter=", ">
          <text variable="title"/>
          <text variable="genre"/>
          <text variable="publisher"/>
          <text variable="number"/>
        </group>
      </else-if>
      <else-if type="chapter">
        <group delimiter=", ">
          <group delimiter=" ">
            <text value="in"/>
            <text variable="container-title"/>
          </group>
          <text variable="publisher"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text macro="container"/>
          <text variable="volume"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="article">
        <group delimiter=", ">
          <text macro="container"/>
          <text variable="number"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="container"/>
          <text variable="volume"/>
          <text variable="page"/>
          <text variable="URL"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=" " prefix=" ">
        <text macro="author"/>
        <text macro="year"/>
        <text macro="locator-details"/>
      </group>
    </layout>
  </bibliography>
</style>
